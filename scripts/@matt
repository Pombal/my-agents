#!/usr/bin/env bash
set -euo pipefail

# Install or update Matt Pocock's skills (github.com/mattpocock/skills) in the
# current project, through `npx skills add`, but without letting it write to
# the project directly: it runs against a copy, you review the diff, and only
# then is the copy folded back. Afterwards, optionally hand over to OMP to run
# setup-matt-pocock-skills.

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  cat <<'EOF'
Usage: @matt [--update] [--official] [npx skills add options...]
Runs `npx skills@latest add mattpocock/skills` on a copy of this project's skills,
shows the diff, asks before applying it, then offers to run setup-matt-pocock-skills in OMP.

  --update    select every Matt skill already in this project that still exists upstream
  --official  select the skills upstream ships in its plugin (.claude-plugin/plugin.json)

Other options are passed to `skills add`, e.g. `@matt -s tdd -a codex`.
Per-project only: choosing a global install in the installer aborts without installing.
EOF
  exit 0
fi

for bin in npx git rsync omp curl jq; do
  command -v "$bin" >/dev/null || { echo "@matt: $bin not found" >&2; exit 1; }
done

update=false official=false args=()
for arg in "$@"; do
  case $arg in
    --update) update=true ;;
    --official) official=true ;;
    *) args+=("$arg") ;;
  esac
done

upstream=https://raw.githubusercontent.com/mattpocock/skills/main
project=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

selected=()
if $official; then
  mapfile -t names < <(curl -fsSL "$upstream/.claude-plugin/plugin.json" | jq -r '.skills[] | split("/") | last')
  selected+=("${names[@]}")
fi
if $update; then
  mapfile -t names < <(curl -fsSL 'https://api.github.com/repos/mattpocock/skills/git/trees/main?recursive=1' |
    jq -r '.tree[].path | select(test("^skills/[^/]+/[^/]+/SKILL\\.md$")) | split("/")[2]')
  declare -A upstream_names=()
  for name in "${names[@]}"; do upstream_names[$name]=1; done
  shopt -s nullglob
  declare -A installed=()
  for skill in "$project"/.*/skills/*/SKILL.md; do
    name=$(basename "$(dirname "$skill")")
    [[ -n ${upstream_names[$name]:-} ]] && installed[$name]=1
  done
  shopt -u nullglob
  if [[ -f $project/skills-lock.json ]]; then
    while read -r name; do
      [[ -z ${upstream_names[$name]:-} ]] && echo "@matt: $name is in skills-lock.json but no longer upstream; left as is"
    done < <(jq -r '.skills | to_entries[] | select(.value.source == "mattpocock/skills") | .key' "$project/skills-lock.json")
  fi
  if ((${#installed[@]} == 0)); then
    echo "@matt: --update found no Matt skills in $project" >&2
    $official || exit 1
  fi
  selected+=("${!installed[@]}")
fi
for name in "${selected[@]}"; do args+=(-s "$name"); done

tmp=$(mktemp -d -t matt-skills.XXXXXX)
trap 'rm -rf "$tmp"' EXIT
before=$tmp/before # the project's skill files as they are
after=$tmp/after   # the same files after the installer ran on them

# Everything the installer reads or writes at a project root: the lock file and
# every agent's skills folder (.agents/skills, .claude/skills, ...). Symlinks
# are copied as symlinks; the installer's own are relative, so they stay valid.
mkdir -p "$before"
shopt -s nullglob
(
  cd "$project"
  for path in skills-lock.json .*/skills; do
    [[ $path == ./skills || $path == ../skills || ! -e $path && ! -L $path ]] && continue
    cp -a --parents "$path" "$before"
  done
)
cp -a "$before" "$after"

# Prompts read the terminal directly: the installer before them may have
# consumed stdin. No terminal, or end of input, counts as "no".
confirm() {
  local answer
  printf '%s [Y/n] ' "$1" >/dev/tty || return 1
  read -r answer </dev/tty || return 1
  [[ ${answer,,} != n* ]]
}

# The installer runs with HOME pointed into the temp folder, so a global
# install (its scope prompt allows one) lands there instead of in your real
# home, where nothing would review it. npm keeps using your real cache and
# config. The global lock file is copied in so the installer still remembers
# your last agent choice, and copied back after a project install.
real_home=$HOME
fake_home=$tmp/home
global_lock=.agents/.skill-lock.json
mkdir -p "$fake_home/.agents"
[[ -f $real_home/$global_lock ]] && cp "$real_home/$global_lock" "$fake_home/$global_lock"

echo "@matt: installing into a copy of $project"
(cd "$after" && HOME=$fake_home npm_config_cache=${npm_config_cache:-$real_home/.npm} \
  npm_config_userconfig=${npm_config_userconfig:-$real_home/.npmrc} \
  npx -y skills@latest add mattpocock/skills "${args[@]}")

if [[ -n $(find "$fake_home" -name SKILL.md -print -quit) ]]; then
  echo "@matt: that was a global install; @matt only installs per project. Nothing was installed." >&2
  exit 1
fi
[[ -f $fake_home/$global_lock ]] && cp "$fake_home/$global_lock" "$real_home/$global_lock"

# --no-index diffs two plain directories; exit code 1 means "differences".
changes=$(git -C "$tmp" diff --no-index --no-renames --name-status before after || true)
if [[ -z $changes ]]; then
  echo "@matt: nothing to change"
else
  echo
  echo "@matt: changes to $project"
  awk -F'\t' '{ p = ($1 == "D") ? $2 : $NF; sub(/^(before|after)\//, "", p);
                s = ($1 == "A") ? "new     " : ($1 == "D") ? "deleted " : "modified";
                print "  " s " " p }' <<<"$changes"
  echo
  # New files are listed above; their full text would bury the changes to
  # existing files, which are what the diff is for.
  if command -v delta >/dev/null; then
    (git -C "$tmp" diff --no-index --no-renames --diff-filter=a before after || true) | delta --paging=never
  else
    git -C "$tmp" diff --no-index --no-renames --diff-filter=a --color=always before after || true
  fi

  if ! confirm "Apply these changes?"; then
    echo "@matt: discarded, project untouched"
    exit 0
  fi
  # -K: where the project has a symlinked directory (e.g. .claude/skills ->
  # ../.agents/skills), write through it instead of replacing it.
  rsync -aK "$after"/ "$project"/
  # rsync without --delete keeps files the installer removed; remove them too.
  while IFS=$'\t' read -r status path; do
    if [[ $status == D ]]; then rm -f -- "$project/${path#before/}"; fi
  done <<<"$changes"
  echo "@matt: applied"
fi

if [[ -e $project/.agents/skills/setup-matt-pocock-skills/SKILL.md ]]; then
  if confirm "Run setup-matt-pocock-skills in OMP now?"; then
    rm -rf "$tmp"
    cd "$project"
    exec omp "Read skill://setup-matt-pocock-skills and follow it."
  fi
fi
