#!/usr/bin/env bash
set -euo pipefail

# Alias kept for muscle memory. The search itself lives in omp-transcript:
# this is `search --hits` over every profile, with reasoning and tool traffic
# included and no row limit.
script_dir=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
omp_transcript=$script_dir/../skills/tool-specific/omp-meta/scripts/omp-transcript

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  printf '%s\n' \
    'Usage: @omp-find [search options] [--] "needle"' \
    'Alias for: omp-transcript search --profile all --reasoning --with-tools --hits -n 0 "$@"' \
    'Run omp-transcript --help for the options, --since/--until among them.'
  exit 0
fi

exec "$omp_transcript" search --profile all --reasoning --with-tools --hits -n 0 "$@"
